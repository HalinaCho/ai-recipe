# Supabase (M0)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — LOGIN client (Supabase Auth "Google" provider config,
# not read directly by the app). Configure in Supabase Dashboard >
# Authentication > Providers, using redirect URI:
# https://<project>.supabase.co/auth/v1/callback

# Google OAuth — GMAIL DATA-ACCESS client (separate from login, FR-01-02).
# M1 scope.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/auth/gmail/callback

# Secret used to encrypt mail_connection.encrypted_secret (AES-256-GCM).
# Must decode to exactly 32 bytes — generate with: openssl rand -base64 32
MAIL_CREDENTIAL_ENCRYPTION_KEY=

# Protects /api/cron/sync-mail. Vercel sets this automatically in
# production; set it locally to exercise the cron route. The route fails
# closed when it's unset, so an unset value never means "open".
CRON_SECRET=

# Gemini API (M1 mail parsing) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the parsing model if the default isn't available on
# your tier (default: gemini-3.7-flash)
GEMINI_MODEL=

# 식약처 COOKRCP01 (M2)
FOODSAFETYKOREA_API_KEY=

# 쿠팡 파트너스 / 네이버쇼핑 (M4)
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=
NAVER_SHOPPING_CLIENT_ID=
NAVER_SHOPPING_CLIENT_SECRET=

# 한국천문연구원 특일정보 (M3)
KASI_HOLIDAY_API_KEY=
